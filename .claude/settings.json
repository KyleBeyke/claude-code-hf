{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "apiKeyHelper": "if [ -n \"$HF_TOKEN\" ]; then printf '%s' \"$HF_TOKEN\"; elif command -v security >/dev/null 2>&1 && security find-generic-password -a \"$USER\" -s claude-hf-token -w >/dev/null 2>&1; then security find-generic-password -a \"$USER\" -s claude-hf-token -w; elif command -v secret-tool >/dev/null 2>&1 && secret-tool lookup service claude-hf-token user \"$USER\" >/dev/null 2>&1; then secret-tool lookup service claude-hf-token user \"$USER\"; elif command -v pass >/dev/null 2>&1 && pass show claude-hf-token >/dev/null 2>&1; then pass show claude-hf-token | head -n 1; else echo \"Missing HF token. Set HF_TOKEN or store claude-hf-token in Keychain/secret-tool/pass.\" >&2; exit 1; fi",
  "model": "sonnet",
  "availableModels": [
    "haiku",
    "sonnet",
    "opus",
    "moonshotai/Kimi-K2.6:together",
    "Qwen/Qwen3-Coder-480B-A35B-Instruct:together",
    "Qwen/Qwen3.6-35B-A3B:deepinfra",
    "Qwen/Qwen3.5-397B-A17B:deepinfra"
  ],
  "env": {
    "ANTHROPIC_BASE_URL": "https://router.huggingface.co",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "moonshotai/Kimi-K2.6:together",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "Kimi K2.6 via Together",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION": "Planner and hard-reasoning slot for debugging, architecture, and final review.",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "Qwen/Qwen3-Coder-480B-A35B-Instruct:together",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "Qwen3 Coder 480B A35B via Together",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION": "Main coding executor for implementation work.",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "Qwen/Qwen3.6-35B-A3B:deepinfra",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "Qwen3.6 35B A3B via DeepInfra",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_DESCRIPTION": "Cheap fast/background slot for small edits, summaries, and low-risk checks.",
    "CLAUDE_CODE_SUBAGENT_MODEL": "Qwen/Qwen3.6-35B-A3B:deepinfra",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "Qwen/Qwen3.5-397B-A17B:deepinfra",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "Qwen3.5 397B A17B via DeepInfra",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "Backup generalist when the primary coding route is slow or unavailable.",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "0"
  },
  "permissions": {
    "deny": [
      "Task(*)",
      "Task(Explore)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/secrets/**)",
      "Read(./playwright/.auth/**)",
      "Read(./artifacts/**)",
      "Read(./memory/**)",
      "Read(./tmp/**)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*wallet*)"
    ]
  },
  "enabledPlugins": {
    "github@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "api-contract-forge@claude-community": true,
    "backend-security-skills@claude-community": true,
    "sonatype-guide@claude-plugins-official": true,
    "agent-protocols@claude-community": false,
    "agentic-guardrails@claude-community": false,
    "attune-lite@claude-community": false,
    "brooks-lint@claude-community": false,
    "brownfield-code-surgeon@claude-community": false,
    "bugbash@claude-community": false,
    "cc-boost@claude-community": false,
    "clangd-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "dependency-evaluator@claude-community": false,
    "feature-dev@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": false,
    "php-lsp@claude-plugins-official": false,
    "playground@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "semgrep@claude-plugins-official": false,
    "session-report@claude-plugins-official": false,
    "superpowers@claude-community": false,
    "swift-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "theme": "dark"
}
