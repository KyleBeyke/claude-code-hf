{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_BASE_URL": "https://router.huggingface.co",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "moonshotai/Kimi-K2.6:cheapest",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "Kimi K2.6 (cheapest route)",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION": "Planner/hard-reasoning slot with cheapest-provider routing.",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "Qwen/Qwen3.6-35B-A3B:cheapest",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "Qwen3.6 35B A3B (cheapest route)",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION": "Main coding executor tuned for lower cost.",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "Qwen/Qwen3.6-35B-A3B:cheapest",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "Qwen3.6 35B A3B (cheapest route)",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_DESCRIPTION": "Cheap fast/background slot for low-risk checks.",
    "CLAUDE_CODE_SUBAGENT_MODEL": "Qwen/Qwen3.6-35B-A3B:cheapest",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "Qwen/Qwen3-Coder-480B-A35B-Instruct:cheapest",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "Qwen3 Coder 480B A35B (cheapest route)",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "Stronger backup route, still using cheapest-provider routing.",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "0"
  },
  "permissions": {
    "deny": [
      "Task(*)",
      "Task(Explore)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/secrets/**)",
      "Read(./playwright/.auth/**)",
      "Read(./artifacts/**)",
      "Read(./memory/**)",
      "Read(./tmp/**)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*wallet*)"
    ]
  },
  "model": "sonnet",
  "availableModels": [
    "haiku",
    "sonnet",
    "opus",
    "moonshotai/Kimi-K2.6:cheapest",
    "Qwen/Qwen3.6-35B-A3B:cheapest",
    "Qwen/Qwen3-Coder-480B-A35B-Instruct:cheapest"
  ],
  "enabledPlugins": {
    "github@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "api-contract-forge@claude-community": true,
    "backend-security-skills@claude-community": true,
    "sonatype-guide@claude-plugins-official": true,
    "agent-protocols@claude-community": false,
    "agentic-guardrails@claude-community": false,
    "attune-lite@claude-community": false,
    "brooks-lint@claude-community": false,
    "brownfield-code-surgeon@claude-community": false,
    "bugbash@claude-community": false,
    "cc-boost@claude-community": false,
    "clangd-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "dependency-evaluator@claude-community": false,
    "feature-dev@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": false,
    "php-lsp@claude-plugins-official": false,
    "playground@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "semgrep@claude-plugins-official": false,
    "session-report@claude-plugins-official": false,
    "superpowers@claude-community": false,
    "swift-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "skipDangerousModePermissionPrompt": true
}
